# KG-CLIR Environment Variables Template
# Copy this file to .env and fill in the values

# ========== Database Configuration ==========
# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kgclir2024
NEO4J_DATABASE=kgclir

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
# ELASTICSEARCH_USERNAME=elastic  # If authentication enabled
# ELASTICSEARCH_PASSWORD=changeme

# ========== LLM API Keys ==========
# Anthropic Claude (Primary for RAG)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI GPT (Fallback)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxx

# ========== Model Cache Paths ==========
# Transformers model cache
TRANSFORMERS_CACHE=./models/transformers
HF_HOME=./models/huggingface

# FAISS index path
FAISS_INDEX_PATH=./models/faiss_index

# ========== Application Configuration ==========
# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Gradio
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=false

# ========== Computation Settings ==========
# Device selection
DEVICE=cuda  # cuda | cpu | mps (Apple Silicon)
CUDA_VISIBLE_DEVICES=0  # GPU device ID

# Parallel processing
NUM_WORKERS=4
BATCH_SIZE=32

# ========== Logging ==========
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/kgclir.log

# ========== Data Paths ==========
DATA_ROOT=./data
OUTPUT_ROOT=./outputs
MODEL_ROOT=./models

# ========== Experiment Configuration ==========
RANDOM_SEED=42
EXPERIMENT_ID=exp_20250126_001

# ========== Feature Flags ==========
ENABLE_NEO4J=true      # Use Neo4j or fallback to networkx
ENABLE_ES=true         # Use Elasticsearch or fallback to rank-bm25
ENABLE_RAG=true        # Enable RAG exercise generation
ENABLE_GPU=true        # Use GPU acceleration
ENABLE_CACHE=true      # Cache embeddings and results

# ========== Development Mode ==========
DEBUG_MODE=false
DEMO_MODE=false        # Use small demo dataset
SKIP_DOWNLOADS=false   # Skip HuggingFace downloads in dev
