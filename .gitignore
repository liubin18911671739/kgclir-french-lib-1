# .gitignore for KG-CLIR French Library

# ========== Python ==========
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ========== Data & Models ==========
# Data files (too large for git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model files
models/*
!models/README.md
!models/.gitkeep

# Outputs
outputs/*
!outputs/kg/.gitkeep
!outputs/alignment/.gitkeep
!outputs/retrieval/.gitkeep
!outputs/learning/.gitkeep

# ========== Logs ==========
logs/*
*.log
!logs/.gitkeep

# ========== IDEs ==========
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm
.idea/
*.iml
*.iws
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ========== OS ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ========== Database ==========
*.db
*.sqlite
*.sqlite3

# Neo4j
neo4j/

# ========== Cache ==========
.cache/
*.cache

# HuggingFace cache
transformers_cache/
huggingface_cache/

# FAISS index
*.faiss
*.index

# ========== Temporary ==========
tmp/
temp/
*.tmp
*.bak
*.backup

# ========== Docker ==========
docker-compose.override.yml

# ========== API Keys ==========
# Never commit API keys!
.env
.env.local
.env.*.local
secrets/
credentials.json

# ========== Project Specific ==========
# Neo4j data
neo4j_data/

# Elasticsearch data
elasticsearch_data/

# Experiment results
experiments/

# Large files
*.tar.gz
*.zip
*.rar
*.7z

# Keep directory structure
!.gitkeep
